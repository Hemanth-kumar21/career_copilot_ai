# ============================================================
# Career Copilot API — Backend Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit your actual .env file to version control.
# ============================================================

# ── Server
PORT=3001

# ── JWT Authentication (use a long random string in production)
JWT_SECRET=change-this-to-a-long-random-secret-in-production

# ── AI Service (OpenAI or compatible)
# The API key lives ONLY here — never in the frontend .env
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_API_BASE=https://api.openai.com/v1

# ── Database (MySQL 8.0+ or PostgreSQL 14+)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=career_copilot
DB_USER=your_database_user
DB_PASSWORD=your_database_password

# ── CORS — set this to your deployed frontend URL in production
# Development: http://localhost:5173
# Production:  https://your-frontend-domain.com
FRONTEND_URL=http://localhost:5173
