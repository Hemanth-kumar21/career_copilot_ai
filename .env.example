# ============================================================
# Career Copilot AI — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit your actual .env file to version control.
# ============================================================

# ── Frontend public variables (VITE_ prefix = bundled into browser JS)
# SAFE to expose — these are just configuration, not secrets.
VITE_APP_NAME=Career Copilot AI
VITE_APP_ENV=production

# Backend API base URL (no trailing slash)
# Development: http://localhost:3001
# Production:  https://api.your-domain.com
VITE_API_BASE_URL=http://localhost:3001

# ── DO NOT add AI API keys here as VITE_ variables.
# ── All AI calls go through the backend. See backend/.env.example.
